# Telegram: створіть бота у @BotFather, chat id можна дізнатись через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Модель для аналізу фото (sonnet | haiku | opus). Можна перевизначити прапорцем --model
# Аналіз тексту завжди на sonnet без роздумів (див. src/analyze/index.ts)
CLAUDE_MODEL=haiku

# Мінімальна оцінка фото (1-10), щоб надіслати оголошення
PHOTO_SCORE_MIN=5

# Скільки оголошень обробити при першому запуску (решта — skipped_initial)
FIRST_RUN_LIMIT=40

# Година (0-23), після якої надсилається щоденний heartbeat
HEARTBEAT_HOUR=20

# Скільки викликів claude одночасно (запити до сайту все одно йдуть по одному)
CLAUDE_PARALLEL=4
